---
const nodes = [
  { x: 50, y: 92, label: "DATA", tone: "amber" },
  { x: 160, y: 236, label: "SYSTEMS", tone: "cyan" },
  { x: 270, y: 322, label: "SIGNALS", tone: "cyan" },
  { x: 375, y: 74, label: "CONTEXT", tone: "amber" },
  { x: 525, y: 326, label: "PEOPLE", tone: "cyan" },
  { x: 642, y: 130, label: "QUESTIONS", tone: "amber" },
  { x: 760, y: 282, label: "PATTERNS", tone: "cyan" },
  { x: 872, y: 86, label: "DECISIONS", tone: "amber" },
];

const initialEnds = [
  { x: 79, y: 79 }, { x: 187, y: 219 }, { x: 297, y: 307 }, { x: 402, y: 89 },
  { x: 550, y: 311 }, { x: 665, y: 115 }, { x: 782, y: 266 }, { x: 846, y: 72 },
];
const cluster = [
  { x: 460, y: 157 }, { x: 494, y: 171 }, { x: 508, y: 205 }, { x: 494, y: 239 },
  { x: 460, y: 253 }, { x: 426, y: 239 }, { x: 412, y: 205 }, { x: 426, y: 171 },
];
const clusterEnds = [
  { x: 460, y: 183 }, { x: 476, y: 189 }, { x: 482, y: 205 }, { x: 476, y: 221 },
  { x: 460, y: 227 }, { x: 444, y: 221 }, { x: 438, y: 205 }, { x: 444, y: 189 },
];

---

<svg
  class="story-diagram"
  viewBox="0 0 920 420"
  role="img"
  aria-labelledby="story-diagram-title story-diagram-description"
  data-story-diagram
>
  <title id="story-diagram-title">Information coming together to support better decisions</title>
  <desc id="story-diagram-description">
    Larger points spread across the full visual, draw toward a shared center, then resolve into a clear analytic view.
  </desc>

  <defs>
    <marker id="story-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#10b9d2" />
    </marker>
  </defs>

  <text x="18" y="25" class="story-diagram__caption">INFORMATION</text>
  <text x="388" y="25" class="story-diagram__caption">CONNECTION</text>
  <text x="770" y="25" class="story-diagram__caption">DIRECTION</text>

  <g class="story-network" data-story-network>
    <g class="story-links" fill="none" stroke-width="1.5">
      {nodes.map((node, index) => (
        <line
          class="story-link"
          data-story-link={index}
          data-scatter-x1={node.x}
          data-scatter-y1={node.y}
          data-scatter-x2={initialEnds[index].x}
          data-scatter-y2={initialEnds[index].y}
          data-cluster-x1={cluster[index].x}
          data-cluster-y1={cluster[index].y}
          data-cluster-x2={clusterEnds[index].x}
          data-cluster-y2={clusterEnds[index].y}
          x1={node.x}
          y1={node.y}
          x2={initialEnds[index].x}
          y2={initialEnds[index].y}
          stroke={index % 2 === 0 ? "#f6aa13" : "#10b9d2"}
          stroke-dasharray="3 8"
          opacity="0.58"
        />
      ))}
    </g>

    {nodes.map((node, index) => (
      <g
        class="story-node"
        data-story-node={index}
        data-scatter-x={node.x}
        data-scatter-y={node.y}
        data-cluster-x={cluster[index].x}
        data-cluster-y={cluster[index].y}
        transform={`translate(${node.x} ${node.y})`}
      >
        <circle r="10" class={`story-node__dot story-node__dot--${node.tone}`} />
        <circle r="14" class="story-node__ring" />
        <text x={node.x > 790 ? -20 : 20} y="4" text-anchor={node.x > 790 ? "end" : "start"} class="story-node__label">{node.label}</text>
      </g>
    ))}

    <g class="story-core" data-story-core opacity="0" transform="translate(0 12)">
      <circle cx="460" cy="205" r="24" fill="none" stroke="#10b9d2" stroke-width="1" opacity="0.62" />
      <circle cx="460" cy="205" r="12" fill="none" stroke="#00102e" stroke-width="1" opacity="0.32" />
      <path d="M 460 173 V 237 M 428 205 H 492" stroke="#00102e" stroke-width="1" opacity="0.24" />
      <circle cx="460" cy="205" r="6" fill="#f6aa13" />
      <text x="460" y="292" text-anchor="middle" class="story-core__label">ONE VIEW</text>
    </g>
  </g>

  <g class="insight-view" data-insight-view opacity="0" transform="translate(92 42) scale(.8)">
    <path d="M 190 62 H 730" stroke="#bfc0ba" stroke-width="1" />
    <text x="460" y="88" text-anchor="middle" class="insight-view__eyebrow">INFORMED ACTION</text>
    <text x="460" y="119" text-anchor="middle" class="insight-view__title">See what matters</text>
    <path d="M 210 286 H 710 M 210 246 H 710 M 210 206 H 710 M 210 166 H 710" stroke="#d8d5cc" stroke-width="1" />
    <path d="M 210 294 V 158" stroke="#9ca5ad" stroke-width="1" />
    <g class="story-bars" fill="#10b9d2">
      <rect class="story-bar" data-story-bar data-height="42" x="252" y="294" width="20" height="0" />
      <rect class="story-bar" data-story-bar data-height="64" x="338" y="294" width="20" height="0" />
      <rect class="story-bar" data-story-bar data-height="53" x="424" y="294" width="20" height="0" />
      <rect class="story-bar" data-story-bar data-height="84" x="510" y="294" width="20" height="0" />
      <rect class="story-bar" data-story-bar data-height="111" x="596" y="294" width="20" height="0" fill="#f6aa13" />
      <rect class="story-bar" data-story-bar data-height="75" x="682" y="294" width="20" height="0" />
    </g>
    <path class="story-chart-line" d="M 261 258 L 347 226 L 433 237 L 519 198 L 605 174 L 691 188" fill="none" stroke="#00102e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="460" stroke-dashoffset="460" />
    <circle cx="691" cy="188" r="5" fill="#f6aa13" />
    <text x="460" y="346" text-anchor="middle" class="insight-view__eyebrow">FROM INFORMATION TO DIRECTION</text>
    <text x="460" y="371" text-anchor="middle" class="insight-view__prompt">What should we do next?</text>
    <path d="M 210 390 H 710" stroke="#10b9d2" stroke-width="1" />
  </g>
</svg>
