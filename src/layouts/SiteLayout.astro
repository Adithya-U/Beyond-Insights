---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Beyond Insights — Data, Analytics & AI",
  description = "Data engineering, artificial intelligence, and business analytics for clearer decisions.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06142f" />
    <link rel="icon" type="image/png" href="/images/beyond-insights-mark.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
