---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StoryDiagram from "../components/StoryDiagram.astro";
import homepage from "../../content/site/homepage.json";

const mailLink = homepage.contactEmail ? `mailto:${homepage.contactEmail}` : "";
---

<SiteLayout title={homepage.seoTitle} description={homepage.seoDescription}>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main">
    <section class="hero section-wrap" aria-labelledby="hero-title">
      <div class="hero__copy reveal">
        <p class="eyebrow"><span class="eyebrow__dash"></span>{homepage.heroEyebrow}</p>
        <h1 id="hero-title">{homepage.heroTitle}</h1>
        <p class="hero__body">{homepage.heroDescription}</p>
        <div class="hero__actions">
          {mailLink ? (
            <a class="button button--amber" href={mailLink}>{homepage.primaryCta}<span aria-hidden="true">↗</span></a>
          ) : (
            <a class="button button--amber" href="#contact">{homepage.primaryCta}<span aria-hidden="true">↓</span></a>
          )}
          <a class="text-link" href="#services">{homepage.secondaryCta}<span aria-hidden="true">↘</span></a>
        </div>
      </div>

    </section>

    <section class="transformation" aria-labelledby="story-title">
      <div class="transformation__intro section-wrap">
        <p class="eyebrow"><span class="eyebrow__dash"></span>{homepage.storyEyebrow}</p>
        <h2 id="story-title">{homepage.storyTitle}</h2>
        <p>{homepage.storyDescription}</p>
      </div>

      <div class="story-scenes" data-story-scenes>
        <div class="story-sticky">
          <div class="story-sticky__inner section-wrap">
            <div class="story-copy">
              <ol class="story-steps">
                {homepage.storySteps.map((step, index) => (
                  <li class={`story-step ${index === 0 ? "is-active" : ""}`} data-story-step={index}>
                    <span class="story-step__number">{step.number}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <div class="story-copy__progress" aria-hidden="true"><span data-story-progress></span></div>
            </div>
            <figure class="story-figure">
              <StoryDiagram />
              <figcaption class="sr-only">An illustration of data and systems becoming useful context for informed action.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="services section-wrap" id="services" aria-labelledby="services-title">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow"><span class="eyebrow__dash"></span>{homepage.servicesEyebrow}</p>
          <h2 id="services-title">{homepage.servicesTitle}</h2>
        </div>
      </div>
      <div class="service-list">
        {homepage.services.map((service) => (
          <article class="service-item reveal">
            <span class="service-item__number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="service-item__line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="approach__inner section-wrap">
        <div class="approach__intro reveal">
          <p class="eyebrow eyebrow--dark"><span class="eyebrow__dash"></span>{homepage.approachEyebrow}</p>
          <h2 id="approach-title">{homepage.approachTitle}</h2>
          <p>{homepage.approachDescription}</p>
        </div>
        <ol class="approach-list">
          {homepage.approachSteps.map((step, index) => (
            <li class="approach-item reveal">
              <span class="approach-item__number">0{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.description}</p></div>
              <span class="approach-item__arrow" aria-hidden="true">↗</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about section-wrap" id="about" aria-labelledby="about-title">
      <div class="about__copy reveal">
        <p class="eyebrow"><span class="eyebrow__dash"></span>{homepage.aboutEyebrow}</p>
        <h2 id="about-title">{homepage.aboutTitle}</h2>
      </div>
      <p class="about__body reveal">{homepage.aboutDescription}</p>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="contact__inner section-wrap">
        <div class="contact__copy reveal">
          <p class="eyebrow eyebrow--dark"><span class="eyebrow__dash"></span>{homepage.contactEyebrow}</p>
          <h2 id="contact-title">{homepage.contactTitle}</h2>
          <p>{homepage.contactDescription}</p>
        </div>
        <div class="contact__aside reveal">
          <p class="contact__aside-label">A useful place to start</p>
          <ul class="contact__prompts">
            {homepage.contactPrompts.map((prompt) => <li>{prompt}</li>)}
          </ul>
          {mailLink && <a class="button button--navy" href={mailLink}>{homepage.primaryCta}<span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner section-wrap">
      <a class="footer-brand" href="#top">Beyond <span>Insights</span></a>
      <p>{homepage.footerDescription}</p>
      <a href="#top" class="back-to-top">Back to top ↑</a>
      <small>© {new Date().getFullYear()} Beyond Insights</small>
    </div>
  </footer>
</SiteLayout>

<script>
  import "../scripts/scroll-story";
</script>
